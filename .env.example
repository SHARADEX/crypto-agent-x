# CryptoEarn Agent — environment template
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- Database (REQUIRED) -----------------------------------------------------
# Local dev / sandbox: SQLite file (Prisma "dev" schema).
DATABASE_URL="file:/home/z/my-project/db/custom.db"
# Production / CI: PostgreSQL connection string (Prisma "prod" schema), e.g.
# DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/dbname?sslmode=require"

# --- GitHub (REQUIRED for real PR submission) --------------------------------
# Personal Access Token with `repo` + `workflow` scopes.
# Used by the github-pr execution adapter to fork + open PRs for bounties.
GITHUB_TOKEN=""

# --- LLM providers (optional — first configured one wins) --------------------
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
HF_TOKEN=""
MISTRAL_API_KEY=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
ZAI_API_KEY=""
NVIDIA_API_KEY=""

# --- Search providers (optional) ----------------------------------------------
BRAVE_API_KEY=""
TAVILY_API_KEY=""
SERPER_API_KEY=""
EXA_API_KEY=""
JINA_API_KEY=""
